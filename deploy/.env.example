# Konfiguration des ArtCraft-MCP-Stacks.
# Diese Datei ist nicht im Git (siehe .gitignore im Repo-Root).

# Welche Craft-Apps installiert werden (kommasepariert, "all" = alle 13).
# Moegliche Werte: wordcraft deckcraft gridcraft photocraft pdfcraft vectorcraft
#                  lightcraft filmcraft designcraft effectcraft cadcraft soundcraft
#                  figcraft
CRAFT_APPS=all

# Bearer-Token fuer den Gateway. Ist es gesetzt, verlangt der Gateway
# "Authorization: Bearer <token>".
#
# Das Token ist noetig, sobald andere Container den Gateway ueber ein
# gemeinsames Netz erreichen - etwa einen Agenten-Container. Ohne Token
# waere jeder Container auf diesem Netz berechtigt.
#
# Erzeugen z.B. mit: openssl rand -hex 24
MCP_BEARER_TOKEN=

# UID/GID des Host-Users. Die erzeugten Dateien im Verzeichnis work/ sollen dem
# Host-User gehoeren, nicht dem Container-User.
UID=1000
GID=1000

# Gemeinsames Netz mit anderen Stacks. Standardmaessig legt der Stack sein
# eigenes Netz an (self-contained). Wer den Gateway in ein bestehendes Netz
# haengen will, setzt den Namen und schaltet external auf true:
#
#   CRAFT_NETWORK=caddy-net
#   CRAFT_NETWORK_EXTERNAL=true
#
# Das Netz muss dann existieren, sonst startet der Stack nicht. Details:
# ../docs/agent-integration.md
CRAFT_NETWORK=craft-net
CRAFT_NETWORK_EXTERNAL=false
