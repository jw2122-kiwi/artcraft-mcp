# Konfiguration des ArtCraft-MCP-Stacks.
# Diese Datei ist nicht im Git (siehe .gitignore im Repo-Root).

# Welche Craft-Apps installiert werden (kommasepariert, "all" = alle 13).
# Moegliche Werte: wordcraft deckcraft gridcraft photocraft pdfcraft vectorcraft
#                  lightcraft filmcraft designcraft effectcraft cadcraft soundcraft
#                  figcraft
CRAFT_APPS=all

# Optionales Bearer-Token. Ist es gesetzt, verlangt der Gateway
# "Authorization: Bearer <token>". Ohne Token laeuft der Endpunkt offen -
# das ist nur vertretbar, solange er an 127.0.0.1 gebunden ist.
# Erzeugen z.B. mit: openssl rand -hex 24
MCP_BEARER_TOKEN=

# UID/GID des Host-Users. Die erzeugten Dateien im Verzeichnis work/ sollen dem
# Host-User gehoeren, nicht dem Container-User.
UID=1000
GID=1000
